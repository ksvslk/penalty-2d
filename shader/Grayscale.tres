[gd_resource type="ShaderMaterial" load_steps=2 format=3]

[sub_resource type="Shader" id="Shader_grayscale"]
code = "shader_type canvas_item;

uniform bool grayscale = false;

void fragment()
{
	if (grayscale)
	{
		vec4 col = texture(TEXTURE, UV);
		float grey = (col.r + col.g + col.b) * 0.333;
		COLOR = vec4(grey, grey, grey, col.a);
	}
	else {
		vec4 col = texture(TEXTURE, UV);
		COLOR = vec4(col.r, col.g, col.b, col.a);
	}
}"

[resource]
resource_local_to_scene = true
shader = SubResource("Shader_grayscale")
shader_parameter/grayscale = false
