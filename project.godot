; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=4

_global_script_classes=[ {
"base": "RigidBody2D",
"class": "Ball",
"language": "GDScript",
"path": "res://scripts/ball.gd"
}, {
"base": "Button",
"class": "CountryButton",
"language": "GDScript",
"path": "res://scripts/country_button.gd"
}, {
"base": "ColorRect",
"class": "GoalIndicator",
"language": "GDScript",
"path": "res://scripts/goal_indicator.gd"
}, {
"base": "Node2D",
"class": "Mediator",
"language": "GDScript",
"path": "res://scripts/level.gd"
} ]
_global_script_class_icons={
"Ball": "",
"CountryButton": "",
"GoalIndicator": "",
"Mediator": ""
}

[application]

config/name="Penalty Frenzy"
run/main_scene="res://Master.tscn"
boot_splash/bg_color=Color( 0, 0, 0, 1 )
config/icon="res://icon.png"

[autoload]

Data="*res://autoload/Data.gd"
C="*res://autoload/C.gd"
DebugLine="*res://scenes/DebugLine.tscn"

[display]

window/size/width=1080
window/size/height=2400
window/size/test_width=800
window/size/test_height=1280
window/handheld/orientation="portrait"
window/stretch/mode="2d"
window/stretch/aspect="keep"

[editor_plugins]

enabled=PoolStringArray(  )

[gui]

common/drop_mouse_on_gui_input_disabled=true

[input_devices]

pointing/emulate_touch_from_mouse=true

[layer_names]

2d_physics/layer_1="ball"
2d_physics/layer_2="wall"
2d_physics/layer_3="goal"
2d_physics/layer_4="keeper"

[locale]

