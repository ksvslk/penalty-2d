; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=4

_global_script_classes=[ {
"base": "RigidBody2D",
"class": "Ball",
"language": "GDScript",
"path": "res://scripts/ball.gd"
}, {
"base": "Button",
"class": "CountryButton",
"language": "GDScript",
"path": "res://scripts/country_button.gd"
}, {
"base": "Button",
"class": "CountrySelectButton",
"language": "GDScript",
"path": "res://scripts/country_select_button.gd"
}, {
"base": "ColorRect",
"class": "GoalIndicator",
"language": "GDScript",
"path": "res://scripts/goal_indicator.gd"
}, {
"base": "Node",
"class": "Master",
"language": "GDScript",
"path": "res://Master.gd"
}, {
"base": "Node2D",
"class": "Mediator",
"language": "GDScript",
"path": "res://scripts/level.gd"
} ]
_global_script_class_icons={
"Ball": "",
"CountryButton": "",
"CountrySelectButton": "",
"GoalIndicator": "",
"Master": "",
"Mediator": ""
}

[application]

config/name="Penalty 2D"
run/main_scene="res://Master.tscn"
boot_splash/show_image=false
boot_splash/fullsize=false
boot_splash/bg_color=Color( 0, 0, 0, 1 )
config/icon="res://art/icon/icon.png"

[autoload]

Data="*res://autoload/Data.gd"
C="*res://autoload/C.gd"
DebugLine="*res://scenes/DebugLine.tscn"
GPack="*res://autoload/GPack.gd"

[display]

window/size/width=1080
window/size/height=2400
window/size/test_width=800
window/size/test_height=1280
window/handheld/orientation="portrait"
window/stretch/mode="2d"
window/stretch/aspect="keep"

[editor_plugins]

enabled=PoolStringArray(  )

[gui]

common/drop_mouse_on_gui_input_disabled=true
theme/custom="res://DefaultTheme.tres"

[input_devices]

pointing/emulate_touch_from_mouse=true

[layer_names]

2d_physics/layer_1="ball"
2d_physics/layer_2="wall"
2d_physics/layer_3="goal"
2d_physics/layer_4="keeper"

[locale]

test="et_EE"
translation_remaps={
}

[physics]

common/enable_pause_aware_picking=true

[rendering]

quality/driver/driver_name="GLES2"
vram_compression/import_etc=true
vram_compression/import_etc2=false
environment/default_clear_color=Color( 0, 0, 0, 1 )
environment/default_environment="res://default_env.tres"
