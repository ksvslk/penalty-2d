[application]

config/name="Penalty 2D"
run/main_scene="res://Master.tscn"
boot_splash/show_image=false
boot_splash/image="res://art/football.svg"
boot_splash/fullsize=false
boot_splash/bg_color=Color( 0, 0, 0, 1 )
config/icon="res://art/icon/Icon.png"

[autoload]

Data="*res://autoload/Data.gd"
C="*res://autoload/C.gd"
GPack="*res://autoload/GPack.gd"
MobileAds="*res://addons/admob/src/singletons/MobileAds.gd"

[display]

window/size/width=1080
window/size/height=2400
window/size/always_on_top=true
window/size/test_width=800
window/size/test_height=1280
window/handheld/orientation="portrait"
window/stretch/mode="2d"
window/stretch/aspect="keep"

[editor_plugins]

enabled=PoolStringArray( "res://addons/admob/plugin.cfg" )

[gui]

common/drop_mouse_on_gui_input_disabled=true
theme/custom="res://DefaultTheme.tres"

[input_devices]

pointing/emulate_touch_from_mouse=true

[layer_names]

2d_physics/layer_1="ball"
2d_physics/layer_2="wall"
2d_physics/layer_3="goal"
2d_physics/layer_4="keeper"

[locale]

translation_remaps={
}

[physics]

common/enable_pause_aware_picking=true

[rendering]

quality/driver/driver_name="GLES2"
vram_compression/import_etc=true
vram_compression/import_etc2=false
vram_compression/import_pvrtc=true
environment/default_clear_color=Color( 0, 0, 0, 1 )
environment/default_environment="res://default_env.tres"
